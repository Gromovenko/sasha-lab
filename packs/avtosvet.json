  "rules": [
    {
      "id": "ask-canbus-from-text",
      "when": {
        "text": [
          "обманк",
          "canbus",
          "кан-шин",
          "ошибка на панели",
          "ошибку света"
        ]
      },
      "then": {
        "addItem": "obmanka"
      }
    },
    {
      "id": "ask-frame-from-text",
      "when": {
        "text": [
          "рамк",
          "переходник"
        ]
      },
      "then": {
        "addItem": "frame"
      }
    },
    {
      "id": "fog-from-text",
      "when": {
        "text": [
          "потеют",
          "запотева",
          "конденсат"
        ]
      },
      "then": {
        "addItem": "seal",
        "note": "Раз фары потеют — при вскрытии переклею герметик, иначе конденсат вернётся уже с новой линзой."
      }
    },
    {
      "id": "need-year",
      "when": {
        "absent": "subject.year"
      },
      "then": {
        "ask": "Подскажите год выпуска машины — от него зависит, какая там фара."
      }
    },
    {
      "id": "need-model",
      "when": {
        "absent": "subject.model"
      },
      "then": {
        "ask": "Какая марка и модель автомобиля?"
      }
    },
    {
      "id": "need-photo",
      "when": {
        "photos": 0
      },
      "then": {
        "ask": "Скиньте, пожалуйста, фото фары — по нему видно тип оптики и сколько места за ней под новый модуль."
      }
    }
  ],
