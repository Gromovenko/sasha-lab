    "checklist": [
      {
        "code": "front",
        "ask": "фару спереди целиком (чтобы видеть тип оптики и состояние стекла)"
      },
      {
        "code": "inside",
        "ask": "фару сзади/из-под капота — там видно, сколько места за отражателем"
      }
    ]
  },
  "vision": {
    "instruction": "На фото — автомобильная фара или подкапотное пространство рядом с фарой. Определи тип оптики, состояние стекла и отражателя и есть ли место за фарой под новый модуль с радиатором.",
    "findings": [
      {
        "code": "tight_space",
        "label": "мало места за фарой под радиатор линзы",
        "then": {
          "requireTags": [
            "compact"
          ],
          "note": "У вас мало места в фаре, поэтому встаёт ограниченное количество линз — лучшие варианты я описал выше."
        }
      },
      {
        "code": "canbus",
        "label": "штатный LED/ксенон — нужны обманки",
        "then": {
          "addItem": "obmanka",
          "note": "В вашей фаре штатный источник с контролем ламп: без обманок бортовой компьютер будет ругаться на ошибку света."
        }
      },
      {
        "code": "needs_frame",
        "label": "нужна переходная рамка под модуль",
        "then": {
          "addItem": "frame"
        }
      },
      {
        "code": "cracked_glass",
        "label": "трещина/скол на стекле фары",
        "then": {
          "ask": "На стекле видно повреждение. Менять стекло будем или ставим линзы как есть?",
          "note": "На стекле есть повреждение — по фото видно трещину. Замену стекла считаю отдельно, после осмотра."
        }
      },
      {
        "code": "fogging",
        "label": "следы запотевания внутри фары",
        "then": {
          "addItem": "seal",
          "note": "Внутри фары следы конденсата — при вскрытии проклею герметиком заново, иначе новая линза запотеет так же."
        }
      },
      {
        "code": "reflector_burnt",
        "label": "облез/выгорел отражатель",
        "then": {
          "note": "Отражатель подгоревший — со штатной оптикой света больше не станет, линза здесь и есть решение."
        }
      },
      {
        "code": "aftermarket_led",
        "label": "уже стоят китайские LED-лампы в рефлекторе",
        "then": {
          "note": "LED-лампы в рефлекторе светят «в никуда» и слепят встречных — по закону это тоже нарушение. Линза даёт нормальную границу света."
        }
      },
      {
        "code": "halogen_reflector",
        "label": "штатный галоген с отражателем"
      },
      {
        "code": "unclear",
        "label": "по фото не разобрать",
        "then": {
          "ask": "По присланному фото не разобрать оптику. Скиньте, пожалуйста, фару целиком при дневном свете."
        }
      }
    ]
  },
