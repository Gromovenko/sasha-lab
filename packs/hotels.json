  "rules": [
    {
      "id": "need-dates",
      "when": {
        "absent": "subject.checkin"
      },
      "then": {
        "ask": "На какие даты ищем размещение?"
      }
    },
    {
      "id": "need-guests",
      "when": {
        "absent": "subject.guests"
      },
      "then": {
        "ask": "Сколько человек едет и есть ли дети?"
      }
    },
    {
      "id": "kids",
      "when": {
        "text": [
          "с детьми",
          "ребёнк",
          "ребенк"
        ]
      },
      "then": {
        "requireTags": [
          "family"
        ],
        "note": "Подобрал варианты, где детская кроватка и питание для ребёнка уже включены."
      }
    },
    {
      "id": "transfer-from-text",
      "when": {
        "text": [
          "трансфер",
          "встретить в аэропорту"
        ]
      },
      "then": {
        "addItem": "transfer"
      }
    },
    {
      "id": "insurance-from-text",
      "when": {
        "text": [
          "страхов"
        ]
      },
      "then": {
        "addItem": "insurance"
      }
    }
  ],
  "offer": {
    "title": "ПОДБОР РАЗМЕЩЕНИЯ",
    "subtitle": "ЦЕНЫ ЗА НОЧЬ, НАЛИЧИЕ ПОДТВЕРЖДАЮ ПРИ БРОНИРОВАНИИ:",
    "maxChoices": 3,
    "template": "{{title}}\n\n{{subtitle}}\n\n{{#choices}}✔️ {{title}} — {{price}}\n{{/choices}}{{#hasExtras}}\nДОПОЛНИТЕЛЬНО:\n\n{{#extras}}➕ {{title}} — {{sum}}\n{{/extras}}{{/hasExtras}}\nИТОГО: {{total}}\n\nЧТО ВХОДИТ:\n\n{{#includes}}🔹 {{.}}\n{{/includes}}{{#hasNotes}}\n{{#notes}}{{.}}\n{{/notes}}{{/hasNotes}}\n{{closing}}",
    "closing": "Забронирую в течение дня, работаем {{workHours}}.",
    "questionTemplate": "{{greeting}}\n\n{{#questions}}— {{.}}\n{{/questions}}\n{{#hasNotes}}\n{{#notes}}{{.}}\n{{/notes}}{{/hasNotes}}",
    "defaultTags": [
      "hotel"
    ]
  },
  "greeting": "Здравствуйте! Подберу варианты, только уточню:",
