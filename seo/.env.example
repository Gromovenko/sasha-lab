# Доступы SEO-модуля. Настоящий файл (seo/.env) в репозиторий НЕ коммитится.
# Раскладывается на сервере и подхватывается pm2 (--update-env).

# ── База проекта (postgres, своя на RU: docker sashalab-pg) ────────────────
# Без неё панель и форма вопроса не работают: вопросы, материалы, семантика и
# позиции живут там. Пароль — в /root/gromovenko/RESTORE-STATE.md на RU.
SASHALAB_PG_URL=postgres://sashalab:ПАРОЛЬ@127.0.0.1:5446/sashalab

# ── Пароль панели собственника (/seo) ──────────────────────────────────────
SEO_ADMIN_PASSWORD=
# Необязательно: отдельный секрет для подписи сессии. Если пуст — берётся пароль.
SEO_SESSION_SECRET=
SEO_DOMAIN=sasha-lab.ru

# ── Yandex AI Studio: Wordstat + Search API ────────────────────────────────
# Консоль → сервисный аккаунт → роль search-api.webSearch.user → API-ключ.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# ── Яндекс.Вебмастер (реальные показы и позиции сайта) ─────────────────────
# OAuth-токен аккаунта, у которого сайт подтверждён в Вебмастере.
YANDEX_WEBMASTER_TOKEN=

# ── Google Search Console ──────────────────────────────────────────────────
# JSON-ключ сервисного аккаунта Google Cloud; сам аккаунт добавлен в GSC
# как пользователь ресурса с правом чтения.
GSC_KEY_FILE=/opt/sasha-lab/secrets/gsc.json
GSC_SITE=sc-domain:sasha-lab.ru

# ══ ДВИЖОК ЗАЯВОК (engine/) ════════════════════════════════════════════════
# Пакет отрасли по умолчанию: файл packs/<id>.json
PACK=avtosvet

# Пароль панели мастера /crm. Если пуст — пускает по SEO_ADMIN_PASSWORD.
CRM_PASSWORD=
# Адрес, по которому мастер открывает карточку из уведомления в телеграме.
CRM_URL=https://sashalab.80-249-150-234.sslip.io

# Кто отвечает клиенту: off — только руками мастера (по умолчанию),
# questions — уточняющие вопросы уходят сами, цена ждёт одобрения,
# all — движок отвечает сам.
ENGINE_AUTOSEND=off

# ── Разбор переписки и зрение по фото (один ключ на всё, GPU в РФ) ─────────
# Без него движок работает на эвристиках: год и телефон вытащит, фото — нет.
NEURALDEEP_API_KEY=
# Необязательно: другая модель под зрение (по умолчанию та же, что у текста).
VISION_MODEL=

# ── Телеграм-бот: приём заявок и уведомление мастера ──────────────────────
# @BotFather → /newbot → токен. MASTER_CHAT_ID — личный чат мастера с ботом
# (узнать: написать боту и посмотреть getUpdates).
TELEGRAM_BOT_TOKEN=
MASTER_CHAT_ID=

# ── Почта ответов (Resend, уже используется в других проектах) ────────────
RESEND_API_KEY=
RESEND_FROM=Студия автосвета <mail@sasha-lab.ru>

# ── Авито-мессенджер и автодиалог ─────────────────────────────────────────
# Кабинет Авито → Настройки → API (developers.avito.ru): там выдают ИМЕННО
# client_id/client_secret приложения. Логин и пароль от кабинета к API НЕ
# подходят: /token принимает только client_credentials (проверено 18.09.2026 —
# на пару «телефон/пароль» отвечает unauthorized_client).
# Работает только с российского адреса: с EU api.avito.ru не отвечает вовсе.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Необязательно: если пусто — берём из /core/v1/accounts/self.
AVITO_USER_ID=
# Автодиалог отдельно по Авито (пусто — общий ENGINE_AUTOSEND):
# questions — уточняющие вопросы уходят сами, цена ждёт мастера;
# all — движок ведёт диалог сам и сразу называет цену.
AVITO_AUTOSEND=questions
# Как часто опрашивать непрочитанные чаты, мс.
AVITO_POLL_MS=60000

# ── Уведомление админа проекта ────────────────────────────────────────────
# Лестница: телеграм (MASTER_CHAT_ID) → СМС на ADMIN_PHONE → WhatsApp.
# Первый сработавший останавливает перебор; не сработало ничего — строка в
# журнале службы. Повторы по одной сделке подавляются ADMIN_NOTIFY_QUIET_MS.
ADMIN_PHONE=79098887575
ADMIN_NOTIFY=telegram,sms,whatsapp
ADMIN_NOTIFY_QUIET_MS=600000
# СМС: sms.ru (api_id) или smsc.ru (логин/пароль). Без них СМС не уходит.
SMSRU_API_ID=
SMSC_LOGIN=
SMSC_PASSWORD=
SMS_FROM=

# ── WhatsApp Cloud API (код готов, на живых ключах не проверен) ───────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Автостраницы базы знаний ──────────────────────────────────────────────
# 0 — вообще не публиковать автоматом (всё в черновики панели /seo).
SEO_AUTOPUBLISH=1
# Сколько независимых фактов нужно, чтобы страница вышла без человека.
AUTOPAGE_STRONG_FACTS=2
