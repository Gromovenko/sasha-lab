# Доступы SEO-модуля. Настоящий файл (seo/.env) в репозиторий НЕ коммитится.
# Раскладывается на сервере и подхватывается pm2 (--update-env).

# ── Пароль панели собственника (/seo) ──────────────────────────────────────
SEO_ADMIN_PASSWORD=
# Необязательно: отдельный секрет для подписи сессии. Если пуст — берётся пароль.
SEO_SESSION_SECRET=
SEO_DOMAIN=sasha-lab.ru

# ── Yandex AI Studio: Wordstat + Search API ────────────────────────────────
# Консоль → сервисный аккаунт → роль search-api.webSearch.user → API-ключ.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# ── Яндекс.Вебмастер (реальные показы и позиции сайта) ─────────────────────
# OAuth-токен аккаунта, у которого сайт подтверждён в Вебмастере.
YANDEX_WEBMASTER_TOKEN=

# ── Google Search Console ──────────────────────────────────────────────────
# JSON-ключ сервисного аккаунта Google Cloud; сам аккаунт добавлен в GSC
# как пользователь ресурса с правом чтения.
GSC_KEY_FILE=/opt/sasha-lab/secrets/gsc.json
GSC_SITE=sc-domain:sasha-lab.ru
